# 必填：Windy Webcams API key，申请地址 https://api.windy.com/keys
WINDY_API_KEY=

# 可选：show 工具把截图传到一个公开 GitHub 仓库，返回 jsDelivr 图片链接
# fine-grained token，只选这一个仓库，Contents 读写
GH_TOKEN=
GH_REPO=yourname/your-snaps

# 可选：Movebank 动物追踪。用户名和密码都要 base64 编码：printf %s '你的用户名' | base64
MOVEBANK_USER_B64=
MOVEBANK_PASS_B64=

# 可选：监听地址，默认 127.0.0.1:8787
HOST=127.0.0.1
PORT=8787

# HTTP / Render 必填：WorkOS AuthKit 域名、与 ChatGPT 地址完全一致的 MCP URL、允许登录的 WorkOS user ID
WORKOS_ISSUER=https://your-authkit-domain
MCP_PUBLIC_URL=https://your-service.onrender.com/mcp
WORKOS_ALLOWED_USER_IDS=user_your_id
